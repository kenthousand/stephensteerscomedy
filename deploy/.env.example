# Copy to deploy/.env on the droplet (not committed to git — see .gitignore)
# and fill in real values. systemd loads this file directly into the
# gunicorn process's environment (see deploy/gunicorn.service).

DJANGO_SECRET_KEY=replace-with-a-real-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=stephensteerscomedy.com,www.stephensteerscomedy.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://stephensteerscomedy.com,https://www.stephensteerscomedy.com
